PORT=3000
NODE_ENV=development

# Interface de escuta. Vazio ou ausente = 0.0.0.0 (aceita a rede local, para
# abrir o sistema pelo celular). Use 127.0.0.1 para restringir a esta máquina.
HOST=0.0.0.0

# Quanto o diário imprime no terminal: depuracao | info | aviso | erro.
# Ausente = depuracao em desenvolvimento, info em produção.
LOG_NIVEL=depuracao

# MySQL. O banco usado pela aplicação é `frio_arte`.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
