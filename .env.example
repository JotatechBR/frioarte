PORT=3000
NODE_ENV=development

# Interface de escuta. Vazio ou ausente = 0.0.0.0 (aceita a rede local, para
# abrir o sistema pelo celular). Use 127.0.0.1 para restringir a esta máquina.
HOST=0.0.0.0

# Quanto o diário imprime no terminal: depuracao | info | aviso | erro.
# Ausente = depuracao em desenvolvimento, info em produção.
LOG_NIVEL=depuracao

# MySQL. O banco usado pela aplicação é `frio_arte`.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Assina o cookie de sessão do sistema interno. Pelo menos 32 caracteres.
# Sem ele o processo sorteia um a cada início — o sistema funciona, mas toda
# reinicialização desloga quem estava usando.
#
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSAO_SEGREDO=

# Duração da sessão, em horas. Ausente = 12.
SESSAO_HORAS=12

# Só ligar quando o sistema estiver atrás de HTTPS: um cookie `Secure` não é
# enviado por HTTP, e o login passa a falhar sem mensagem de erro.
SESSAO_SEGURA=false
